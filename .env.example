APP_NAME=VigiloX Guard Patrol Anomaly Detection
APP_ENV=development
DEBUG=true
TESTING=false
SCHEDULER_ENABLED=true

# PostgreSQL / Supabase connection string.
# Leave unset (or empty) to use local SQLite: sqlite:///./data/app.db
DATABASE_URL=

# Comma-separated origins. Use * for local development.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

WEBHOOK_URL=
WEBHOOK_TOKEN=
WEBHOOK_TIMEOUT_SECONDS=15

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
ALERT_EMAIL_TO=

MODEL_PATH=models
CONFIG_PATH=config
